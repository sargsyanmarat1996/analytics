   "id": "a7d4d231-64ff-4b6e-bbec-5f3b214b9c1a",
   "metadata": {},
   "source": [
    "Использованный DAX код:\n",
    "- Создание таблицы для переключателя:\n",
    "  Показатели = DATATABLE(\"Название показателя\", STRING, {\n",
    "    {\"Выручка\"},\n",
    "    {\"Прибыль\"},\n",
    "    {\"АКБ\"},\n",
    "    {\"Средний чек\"},\n",
    "    {\"Рентабельность\"},\n",
    "    {\"Затраты на логистику\"}\n",
    "})\n",
    "- Привязка переключателя:\n",
    "  Выбранный показатель = \n",
    "    SWITCH(\n",
    "    SELECTEDVALUE('Показатели'[Название показателя]),\n",
    "    \"Выручка\", [Выручка общая],\n",
    "    \"Прибыль\", [Прибыль общая],\n",
    "    \"АКБ\", [АКБ],\n",
    "    \"Затраты на логистику\", [Затраты на логистику],\n",
    "    \"Рентабельность\", [Затраты на логистику],\n",
    "    \"Средний чек\", [Средний чек]\n",
    ")\n",
    "- АКБ. Считали уникальных клиентов с заказами:\n",
    "  АКБ = DISTINCTCOUNT('Продажи'[Покупатель])\n",
    "- Затраты на логистику из таблицы Стоимость доставки:\n",
    "  Затраты на логистику = SUMX('Продажи', RELATED('СПР_стоимость_доставки'[Стоимость доставки]))\n",
    "- Расчёт для ABC классификации:\n",
    "  TotalSales = CALCULATE(SUM('СПР_abc'[Выручка за продукт]), ALLSELECTED('СПР_abc'))\n",
    "  CummulativeSales = \n",
    "    CALCULATE(\n",
    "    SUM('СПР_abc'[Выручка за продукт]),\n",
    "    FILTER(\n",
    "    ALLSELECTED('СПР_abc'),\n",
    "    'СПР_abc'[Выручка за продукт]>=EARLIER('СПР_abc'[Выручка за продукт])))\n",
    "  Cumulativa/Total = 'СПР_abc'[CummulativeSales]/'СПР_abc'[TotalSales]\n",
    "  ABC Classification = \n",
    "    IF('СПР_abc'[Cumulativa/Total]>=0.95, \"C\",\n",
    "        IF('СПР_abc'[Cumulativa/Total]>=0.8, \"B\",\n",
    "            \"A\"))"
   ]
  },
