   "id": "b9ffad5d-9ad3-426a-8186-0dff4ac219d5",
   "metadata": {},
   "source": [
    "Использованный DAX код:\n",
    "- Разницы дат по срезу\n",
    "Период = DATEDIFF(MIN('Календарь'[Даты]),MAX('Календарь'[Даты]),DAY)+1\n",
    "- Разница выручки интервал среза - интервал до\n",
    "Доход - период = 'Отчёт о продажах'[Выручка WB] - CALCULATE([Выручка WB], DATEADD('Календарь'[Даты], 'Календарь'[Период], DAY))\n",
    "- Валовая прибыль с related по столбцу себестоимости\n",
    "Валовая прибыль = 'Отчёт о продажах'[Выручка WB] \n",
    "- CALCULATE(\n",
    "    SUMX('Отчёт о продажах','Отчёт о продажах'[ppvz_reward]+'Отчёт о продажах'[ppvz_vw]+'Отчёт о продажах'[ppvz_vw_nds]+'Отчёт о продажах'[delivery_rub]\n",
    "    +DIVIDE('Отчёт о продажах'[retail_amount],'Отчёт о продажах'[quantity])*0.02+\n",
    "    RELATED('Себестоимость'[Себестоимость])*'Отчёт о продажах'[quantity]), 'Отчёт о продажах'[doc_type_name]=\"Продажа\")\n",
    "-CALCULATE(\n",
    "    SUMX('Отчёт о продажах','Отчёт о продажах'[ppvz_reward]+'Отчёт о продажах'[ppvz_vw]+'Отчёт о продажах'[ppvz_vw_nds]+'Отчёт о продажах'[delivery_rub]\n",
    "    +DIVIDE('Отчёт о продажах'[retail_amount],'Отчёт о продажах'[quantity])*0.02+\n",
    "    RELATED('Себестоимость'[Себестоимость])*'Отчёт о продажах'[quantity]), 'Отчёт о продажах'[doc_type_name]=\"Возврат\")"
   ]
  },
